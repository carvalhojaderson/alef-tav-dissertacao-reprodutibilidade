# Copie para .env em desenvolvimento local (NUNCA comite credenciais).
# No Hugging Face, cadastre cada variavel em Settings > Variables and secrets.

# ---- banco ----------------------------------------------------------------
# Deixe vazio para usar o `alef_tav.db` do projeto (reuso do banco existente).
# Postgres: postgresql+psycopg://usuario:senha@host:5432/banco
# AMBIENTAL_BANCO_URL=

# Move o banco da plataforma para <AMBIENTAL_DADOS>/alef_tav.db (util com
# Persistent Storage do HF montado em /data).
# AMBIENTAL_BANCO_PERSISTENTE=1

# Diretorio de dados persistentes (relatorios + banco quando o item acima = 1).
# AMBIENTAL_DADOS=/data

# ---- CORS -----------------------------------------------------------------
# Sem esta variavel valem as origens conhecidas do frontend (ais-dev-*/ais-pre-*
# do Cloud Run e localhost). Nunca use "*" em producao: o app recusa com 403 a
# origem fora da lista, mesmo que o proxy do provedor ecoe o cabecalho.
# CORS_ORIGENS=https://ais-dev-762xvkh6mpwv73wh6pxb4n-17975995585.us-east1.run.app
# CORS_ORIGEM_REGEX=^https://(ais-(dev|pre)-[a-z0-9-]+(\.[a-z0-9-]+)+\.run\.app|[a-z0-9-]+\.web\.app)$

# ---- persistencia do banco (Space sem disco pago) -------------------------
# O /data de um Space gratuito e' apagado a cada reinicio; com estas variaveis
# o SQLite e' copiado para um dataset privado e restaurado no startup.
# AMBIENTAL_BACKUP_REPO=usuario/ambiental-dados
# AMBIENTAL_BACKUP_INTERVALO=60
# HF_TOKEN=hf_...   (no Space: Settings > Secrets, com escrita no dataset)

# ---- limites --------------------------------------------------------------
# AMBIENTAL_MAX_TAREFAS=4
# AMBIENTAL_TIMEOUT_SIMULADOR=180
# AMBIENTAL_TIMEOUT_EVIDENCIA=45

# ---- nucleo cientifico ----------------------------------------------------
# Caminho do nucleo (universal.py, bancos_rest.py, ...). Padrao: pasta pai do
# pacote. Em Space separado, aponte para onde o nucleo foi copiado.
# ALEF_TAV_CORE=/app

# Credenciais de bases/LLM ficam nos Secrets do Space e sao lidas pelos
# modulos do nucleo (nunca por este arquivo):
# CORE_API_KEY=...
# UNPAYWALL_EMAIL=...
# GEMINI_API_KEY=...
